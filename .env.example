# Local Gym and sample dashboards require no configuration.
# Fill actual values only in ignored .env.local. All integration variables are server-only.
APP_ORIGIN=
# Comma-separated exact origins; no wildcards. Dev additionally permits verified HTTPS LAN.
APP_TRUSTED_ORIGINS=
# Required private production app gate; automatically enabled on Vercel production.
APP_REQUIRE_AUTH=
INTEGRATION_STORAGE=
INTEGRATION_ENCRYPTION_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_API_BASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# IANA timezone for training calendar dates; defaults to Europe/Rome.
POLAR_TIME_ZONE=Europe/Rome
# Deprecated compatibility fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional only for pnpm dev + explicitly selected dev-file storage.
DEV_INTEGRATION_ACCESS_KEY=
# Optional after intentionally creating a public webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
